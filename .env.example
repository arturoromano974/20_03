# .env.example - Environment Variables Template

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Facebook API Configuration
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token-here
FACEBOOK_APP_ID=your-facebook-app-id-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here
FACEBOOK_AD_ACCOUNT_ID=act_your-ad-account-id-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# N8N Configuration
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Agent Ports
CREATIVE_AGENT_PORT=5001
ADS_MANAGER_AGENT_PORT=5002
ANALYTICS_AGENT_PORT=5003
DATA_COLLECTOR_AGENT_PORT=5004

# Logging
LOG_LEVEL=INFO
LOG_PATH=/var/log/marketing-automation

# Optional: Vector Database
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional: Monitoring
# SENTRY_DSN=
